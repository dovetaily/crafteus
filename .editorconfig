root = true

[*.*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{php,md,html,css,js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,scss,sass,less,styl}]
indent_style = tab

[*.{json,lock,md,yaml,yml}]
indent_size = 2


# PHP
[*.{php,html,js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,scss,sass,less,styl}]
tab_width = 4
indent_size = 4

# YAML & JSON & LOCK File & Markdown & CSS
[*.{yaml,yml,json,lock,md,css}]
tab_width = 2

# YAML & JSON & LOCK File
[*.{yaml,yml,json,lock}]
indent_style = space
