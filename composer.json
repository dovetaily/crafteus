{
  "name": "dovetaily/crafteus",
  "type": "library",
  "license": "Apache-2.0",
  "description": "An advanced tool for generating stub files from custom 'Ecosystems'. Designers can create Ecosystems composed of multiple dynamic Templates, defining specific configurations and transformation logic. Users can leverage these Ecosystems to provide data, which will be processed by the designers' configurations and transformed into tailored stub files.",
  "keywords": ["configuration","dynamic templates","ecosystem","file generation","file generator","generator","php","stub","stub generation","stub generator","template","dev"],
  "homepage": "https://github.com/dovetaily/crafteus",
  "authors": [
    {
      "name": "Gedeon Timothy",
      "homepage": "https://github.com/gedeontimothy",
      "email": "gedeonbateko3@gmail.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Crafteus\\": "src/",
      "Crafteus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor\\bin\\phpunit",
    "test-unit-app": "vendor\\bin\\phpunit tests\\Unit\\Environment\\AppTest.php",
    "test-unit-foundation": "vendor\\bin\\phpunit tests\\Unit\\Environment\\FoundationTest.php",
    "test-unit-ecosystem": "vendor\\bin\\phpunit tests\\Unit\\Environment\\EcosystemTest.php",
    "test-unit-template": "vendor\\bin\\phpunit tests\\Unit\\Environment\\TemplateTest.php",
    "test-unit-stub": "vendor\\bin\\phpunit tests\\Unit\\Environment\\StubTest.php",

    "docs": "mkdocs serve -a localhost:8182 --open",
    "dev-docs": "nodemon --watch docs --watch mkdocs.yml --ext md,yml --exec \"mkdocs serve -a localhost:8182\"",
    "build-docs": "mkdocs build",

    "phpstan": "phpstan analyse"
  },
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.64",
    "phpstan/phpstan": "^2.2"
  }
}
